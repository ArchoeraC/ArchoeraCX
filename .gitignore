# ArchoeraCX ignore rules
#
# Keep the patterns narrow: a rule that hides a directory name also hides real
# source. `**/bin/` used to swallow `app/modules/downloader/src/bin/`, which
# made a fresh clone unable to build the Rust downloader CLI.

# --- Flutter / Dart -------------------------------------------------------
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/coverage/
**/ephemeral/

# --- Icon font tooling ----------------------------------------------------
# Only the packaged subset font is committed:
#   app/assets/fonts/AppIcons.ttf          (built artifact, MIT)
#   app/lib/theme/icons/app_icon_data.dart (generated glyph table)
# Everything needed to *build* it stays on this machine: the generator venv,
# the pinned upstream webfont/tarball, and any extracted SVG artwork.
app/.cache/
app/tool/icons/*.ttf
app/tool/icons/*.otf
app/tool/icons/*.tgz
app/tool/icons/*.zip
app/tool/icons/*.zipx
app/assets/icons/ui/*.svg
app/assets/icons/ui/*.ttf
app/assets/icons/ui/*.otf
app/assets/icons/ui/*.woff
app/assets/icons/ui/*.woff2

# --- .NET (business modules only) ----------------------------------------
app/modules/business/**/bin/
app/modules/business/**/obj/
*.user
*.suo
*.userosscache
*.sln.docstates
**/MicrosoftBuildConfig.g.cs

# --- Rust ----------------------------------------------------------------
app/modules/downloader/target/
app/core/vault-rs/target/

# --- Native / CMake ------------------------------------------------------
build/
out/
dist/
*.dmp
*.pdb
*.ilk

# --- Local material ------------------------------------------------------
# Reference/ is read-only source material. Only MANIFEST.md and README.md at
# its root are tracked; upstream checkouts, samples, reverse-engineering notes
# and local caches stay on this machine.
Reference/upstream/
Reference/LauncherX/
Reference/local/
.local/
LauncherX-*.md

# --- IDE / OS ------------------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
desktop.ini

# --- Credentials and runtime data ---------------------------------------
*.log
accounts.json
accounts.credentials.json
archoera.db
archoera.db-shm
archoera.db-wal
settings.json
.env
.env.*
